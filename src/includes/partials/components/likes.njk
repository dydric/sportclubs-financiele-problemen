{#
  Like-component: rij reactie-knoppen onderaan een feed-bericht.

  Frontmatter-opties (allemaal optioneel):
    likes: false            → verberg volledig
    likes: true             → toon met site-standaarden (ook: weglaten = zelfde)
    likes:
      types: ["♥️", "💪"]   → overschrijf de standaard reactie-types (hoogste prioriteit)
      start: 15             → tel dit getal op bij de eerste knop (migratie-offset)

  Type-prioriteit:
    1. likes.types (per bericht)
    2. site.likeTypesByFeedType[type] (per feedtype)
    3. site.likeTypes (algemene fallback)

  De emoji staan bij het laden al in de DOM zodat Twemoji ze bij de
  eerste pass kan omzetten naar <img>. JS past daarna alleen state en
  teller aan — de emoji-inhoud zelf wordt nooit meer gewijzigd.
#}
{% if likes !== false %}

{# Bepaal welke types getoond worden: per-bericht > per-feedtype > site-standaard #}
{% if likes and likes.types %}
  {% set _types = likes.types %}
{% elif type and site.likeTypesByFeedType[type] %}
  {% set _types = site.likeTypesByFeedType[type] %}
{% else %}
  {% set _types = site.likeTypes %}
{% endif %}
{% set _start = likes.start if (likes and likes.start) else "" %}
{% set _reset = likes.reset if (likes and likes.reset) else "" %}

<div
	class="likes-wrapper mt-8 lg:mt-10"
	data-js="likes"
	data-slug="{{ page.fileSlug }}"
	{% if _start %}data-start="{{ _start }}"{% endif %}
	{% if _reset %}data-reset="{{ _reset }}"{% endif %}
	role="region"
	aria-label="Reacties"
>
	<div class="inline-flex items-stretch u-text-sm text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-700 rounded-sm overflow-hidden select-none bg-white dark:bg-stone-900 shadow-xl">

		{% for emoji in _types %}
		<button
			class="like-btn flex items-center gap-2 px-2.5 h-10 leading-none transition-colors hover:bg-neutral-50 dark:hover:bg-neutral-800 {% if not loop.first %}border-l border-neutral-200 dark:border-neutral-700{% endif %}"
			type="button"
			data-type="{{ emoji }}"
			aria-pressed="false"
			aria-label="Reageer met {{ emoji }}, wordt geladen"
			disabled
		>
			{# Emoji-inhoud staat al in de DOM zodat Twemoji hem bij het laden kan verwerken.
			   aria-hidden="true": de knop-aria-label beschrijft de actie al volledig. #}
			<span class="like-icon" aria-hidden="true">{{ emoji }}</span>

			{# Teller: hidden bij 0 likes, beheerd door JS #}
			<span class="like-count u-text-sm text-neutral-600 dark:text-neutral-400" aria-live="polite" aria-atomic="true" hidden></span>
		</button>
		{% endfor %}

	</div>
</div>
{% endif %}
