{% macro feedList(items) %}
  {% for item in items %}
    <details class="group border-t-2 border-border{% if loop.last %} border-b-2{% endif %}">
      <summary class="container block py-3 cursor-pointer list-none select-none">
        <span class="flex items-baseline gap-3">
          <span class="u-text-xl leading-[1.1] lg:tracking-tight flex-1">{{ item.data.title }}</span>
          <span class="shrink-0 text-neutral-400 transition-transform duration-200 group-open:rotate-180 font-mono text-sm" aria-hidden="true">▼</span>
        </span>
      </summary>
      <div class="container pb-6 pt-2">
        <div class="flow content max-w-xl md:max-w-2xl lg:max-w-3xl">
          {{ item.templateContent | safe }}
        </div>
      </div>
    </details>
  {% endfor %}
{% endmacro %}
