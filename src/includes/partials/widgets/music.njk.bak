<div class="widget rounded-lg bg-zinc-800">

	<div class="grid grid-cols-4 gap-2 mx-auto w-[320px]">
	{% set count = 0 %}
	{% for album in albumwhale.data.items %}

		{% set htmlData = album.content | safe %}
		{% set srcStart = htmlData.indexOf('src="') %}

		{% if srcStart != -1 %}
			{% set srcEnd = htmlData.indexOf('"', srcStart + 5) %}
			{% set albumSrc = htmlData.slice(srcStart + 5, srcEnd) %}
			{% if count < 4 %}
			<a href="{{ album.link }}" alt="{{ album.title }}" target="_blank" rel="noopener noreferrer">
			<img
				class="mx-auto w-full max-w-[80px]"
				src="{{ albumSrc }}"
				alt="{{ album.title}}"
				eleventy:widths="160">
			</a>
				{% set count = count + 1 %}
			{% endif %}
		{% endif %}
	{% endfor %}
	</div>

</div>{# /widget #}
