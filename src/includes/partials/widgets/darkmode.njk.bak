{% macro svg_sun_icon(
  class = 'block w-full h-full'
) %}<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 52 52" class="{{ class }}"><path fill="currentcolor" fill-rule="evenodd" d="M26 0a2 2 0 0 1 2 2v6a2 2 0 1 1-4 0V2c0-1.1.9-2 2-2ZM7.62 7.62a2 2 0 0 1 2.82 0l4.25 4.24a2 2 0 1 1-2.83 2.83l-4.24-4.25a2 2 0 0 1 0-2.82Zm36.76 0a2 2 0 0 1 0 2.82l-4.24 4.25a2 2 0 1 1-2.83-2.83l4.25-4.24a2 2 0 0 1 2.82 0ZM26 18a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm-8.49-.49A12 12 0 1 1 34.5 34.5 12 12 0 0 1 17.5 17.5ZM0 26c0-1.1.9-2 2-2h6a2 2 0 1 1 0 4H2a2 2 0 0 1-2-2Zm42 0c0-1.1.9-2 2-2h6a2 2 0 1 1 0 4h-6a2 2 0 0 1-2-2ZM14.69 37.31a2 2 0 0 1 0 2.83l-4.25 4.24a2 2 0 0 1-2.82-2.82l4.24-4.25a2 2 0 0 1 2.83 0Zm22.62 0a2 2 0 0 1 2.83 0l4.24 4.25a2 2 0 0 1-2.82 2.82l-4.25-4.24a2 2 0 0 1 0-2.83ZM26 42a2 2 0 0 1 2 2v6a2 2 0 1 1-4 0v-6c0-1.1.9-2 2-2Z" clip-rule="evenodd"/></svg>{% endmacro %}

{% macro svg_moon_icon(
  class = 'block w-full h-full'
) %}<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 44 44" class="{{ class }}"><path fill="currentcolor" fill-rule="evenodd" d="M16.7 2.59A2 2 0 0 0 14.03.15 22.8 22.8 0 0 0 0 21.2M16.7 2.6v.01l-.01.04a25.02 25.02 0 0 0-.22.76c-.15.5-.34 1.22-.53 2-.4 1.65-.74 3.45-.74 4.6A18.8 18.8 0 0 0 34 28.8c2.48 0 4.94-.49 7.23-1.44a2 2 0 0 1 2.62 2.62A22.8 22.8 0 0 1 0 21.2M11.7 6.02a18.8 18.8 0 1 0 26.14 26.46A22.8 22.8 0 0 1 11.2 10c0-1.2.23-2.65.5-3.99ZM34 32.8v-2 2Z" clip-rule="evenodd"/></svg>{% endmacro %}

<button
  id="open-darkmode-btn"
  class="group flex items-center justify-center text-center w-full h-full bg-black bg-opacity-5 dark:bg-white dark:bg-opacity-15 rounded border-none outline-none"
  aria-label="Open weergave instellingen">
    {{ svg_sun_icon(
      class = "block dark:hidden w-1/2 text-black text-opacity-40 group-hover:scale-90 transition-transform ease-in-out"
    ) }}
    {{ svg_moon_icon(
      class = "hidden dark:block w-1/2 p-[2px] md:p-[4px] text-white text-opacity-40 group-hover:scale-90 transition-transform ease-in-out"
    ) }}
</button>

<div
  id="darkmode-modal"
  class="fixed z-[999] w-screen h-screen bg-gray-200 dark:bg-neutral-900 bg-opacity-60 dark:bg-opacity-75 inset-0 backdrop-blur-xl flex items-center justify-center hidden"
  aria-hidden="true"
  role="dialog"
  aria-labelledby="darkmode-title">

  <div class="relative z-10 text-center">

    <h2 id="darkmode-title" class="text-lg font-extrabold block leading-none tracking-tightest whitespace-nowrap text-black dark:text-white">Weergave</h2>

    {# Opties voor het kiezen van de thema's #}
    {% set options = [
      { name: 'auto', title: 'Automatisch', icon: '', value: 'system', classes: 'bg-white text-neutral-900 dark:bg-neutral-700 dark:text-gray-100' },
      { name: 'light', title: 'Licht', icon: 'sun', value: 'light', classes: 'bg-white text-neutral-900 dark:text-neutral-700' },
      { name: 'dark', title: 'Donker', icon: 'moon', value: 'dark', classes: 'bg-neutral-800 dark:bg-neutral-700 text-gray-200' }
    ] %}
    <div class="flex items-center justify-center py-large">
      {% for option in options %}
        {% if option.icon == '' %}
          {% set classes = option.classes + " min-w-unit px-large" %}
        {% else %}
          {% set classes = option.classes + " w-unit" %}
        {% endif %}
        <button
          class="group rounded h-unit text-center flex items-center justify-center {{ classes }}"
          data-darkmode-option="{{ option.value }}"
          aria-label="Schakel weergave {{ option.name }} in">

          {% if option.icon == 'sun' %}
            {{ svg_sun_icon(
              class="block w-1/2 group-hover:scale-90 transition-transform ease-in-out"
            ) }}
          {% elseif option.icon == 'moon' %}
            {{ svg_moon_icon(
              class="block w-1/2 p-[2px] md:p-[4px] group-hover:scale-90 transition-transform ease-in-out"
            ) }}
          {% else %}
            <span class="text-lg font-extrabold block leading-none tracking-tightest group-hover:scale-95 transition-transform ease-in-out">{{ option.title }}</span>
          {% endif %}
        </button>
      {% endfor %}
    </div>

  </div>
</div>
