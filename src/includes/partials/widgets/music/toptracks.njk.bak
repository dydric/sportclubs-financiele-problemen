<div class="w-unit-5 col-span-5 lg:w-unit-3 lg:col-span-3 ">
	<div class="bg-white text-black dark:bg-neutral-800 dark:text-gray-200 p-large  rounded h-full">
		<div class="flex flex-wrap justify-start  gap-small">
			<div class="w-full">
				<h2 class="text-lg font-extrabold block tracking-tight whitespace-nowrap w-full ">Top Tracks</h2>
				<span class="text-base font-semibold tracking-tight whitespace-nowrap truncate opacity-50">Afgelopen maand</span>
			</div>
			{%- set max_items = 3 -%}
			{% for track in lastfm.topTracks %}
				{%- if loop.index <= max_items -%}
					<a href="https://last.fm/music/{{ track.artist | url | safe }}/_/{{ track.name | url | safe }}"
						target="_blank" rel="noopener noreferrer"
						class="group flex text-neutral-900 dark:text-gray-200 truncate w-full flex-col">
						<span class="text-base font-bold tracking-tight whitespace-nowrap truncate group-hover:opacity-75">{{ track.name }}</span>
						<span class="text-base font-semibold tracking-tight whitespace-nowrap truncate opacity-50 group-hover:opacity-40">{{ track.artist }}</span>
					</a>
				{% endif %}
			{% endfor %}
		</div>
	</div>
</div>
