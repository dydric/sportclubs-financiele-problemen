
<h2>Trends</h2>
<p>Totale scrobbles: {{ lastfm.trends.totalScrobbles }}</p>
<p>Scrobbles afgelopen week: {{ lastfm.trends.weeklyScrobbles }}</p>

<h2 class="text-2xl font-bold">Top Artiesten (Afgelopen maand)</h2>
<ul>
  {% for artist in lastfm.topArtists %}
    <li>
      <strong>{{ artist.name }}</strong> - {{ artist.playcount }} plays
    </li>
  {% endfor %}
</ul>

<h2 class="text-2xl font-bold">Top Albums (Afgelopen maand)</h2>
<ul>
  {% for album in lastfm.topAlbums %}
    <li>
      <strong>{{ album.name }}</strong> - {{ album.artist }}
      {% if album.image %}
        <img src="{{ album.image }}" alt="{{ album.name }}" eleventy:widths="160" class="max-w-[80px]">
      {% endif %}
    </li>
  {% endfor %}
</ul>

<h2 class="text-2xl font-bold">Top Tracks (Afgelopen maand)</h2>
<ul>
  {% for track in lastfm.topTracks %}
    <li>
      <strong>{{ track.name }}</strong> - {{ track.artist }}
      {% if track.image %}
        <img src="{{ track.image }}" alt="{{ track.name }}" eleventy:widths="160" class="max-w-[80px]">
      {% endif %}
    </li>
  {% endfor %}
</ul>
