{% macro poiRow(poi) %}
	<li class="poi-list-item">
		<button type="button" class="toggle-list-button group text-left u-text-md cursor-pointer {% if poi.favorite %}is-favorite{% endif %}" data-poi-target="{{ poi.id }}">
			<span class="toggle-list-marker poi-list-marker" style="--poi-icon: url('{{ poi.iconPath or '/assets/poi/none.svg' }}')">
				<span class="poi-list-marker-circle">
					<span class="poi-list-marker-icon" aria-hidden="true"></span>
				</span>
			</span>
			<span class="toggle-list-track poi-list-track">
				<span class="toggle-list-heading">{{ poi.name }}</span>
				{% if poi.favorite %}
					<span class="toggle-list-favorite" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path fill="currentColor" d="M329.6 176H488C498.3 176 507.4 182.5 510.7 192.2C514 201.9 510.8 212.6 502.7 218.9L371.9 320.7L422.9 480.7C426.1 490.7 422.4 501.7 413.7 507.7C405.1 513.7 393.6 513.4 385.3 506.9L256 406.4L126.7 506.9C118.4 513.4 106.9 513.7 98.27 507.7C89.65 501.7 85.94 490.7 89.13 480.7L140.1 320.7L9.267 218.9C1.174 212.6-2.027 201.9 1.3 192.2C4.628 182.5 13.75 176 24 176H182.5L233.1 16.72C236.3 6.764 245.6 0 256 0C266.5 0 275.7 6.764 278.9 16.72L329.6 176z"/></svg>
					</span>
				{% elif poi.address or poi.description or poi.url %}
					<span class="poi-list-chevron" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
					</span>
				{% endif %}
				<span class="poi-list-category visually-hidden">{{ poi.categoryLabel or poi.category }}</span>
			</span>
		</button>
		{% if poi.address or poi.description or poi.url %}
			<div class="poi-list-panel" data-poi-panel="{{ poi.id }}" hidden>
				{% if poi.description %}
					<p class="poi-list-description">{{ poi.description }}</p>
				{% endif %}
				{% if poi.address %}
					<p class="poi-list-address">{{ poi.address }}</p>
				{% endif %}
				{% if poi.url %}
					{% set websiteLabel = "Instagram" if "instagram.com" in (poi.url | lower) else "Website" %}
					<a href="{{ poi.url }}" class="poi-list-link" target="_blank" rel="noopener noreferrer">{{ websiteLabel }}</a>
				{% endif %}
			</div>
		{% endif %}
	</li>
{% endmacro %}

{% set mapKey = poiMapKey or (kaart or map or '') %}
{% set hasPoiItems = poiItems and poiItems.length %}
{% set groups = poiGroups if poiGroups and poiGroups.length else [] %}
{% set poiClustersEnabled = true %}
{% if clusters is defined and clusters == false %}
	{% set poiClustersEnabled = false %}
{% endif %}

{% if mapKey and hasPoiItems %}
	<script id="poi-data-{{ page.fileSlug }}" type="application/json">[{% for poi in poiItems %}{"id":{{ poi.id | dump | safe }},"category":{{ poi.category | dump | safe }},"favorite":{{ (poi.favorite or false) | dump | safe }},"coordinates":{{ poi.coordinates | dump | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]</script>

		<div class="activity poi relative w-full flex-1 overflow-hidden flex flex-col lg:flex-row">
			<div class="activity-map poi-map w-full flex shrink-0 grow-0 items-stretch min-h-[50svh] max-h-[50svh] lg:min-h-0 lg:max-h-none lg:flex-1 lg:order-1 border-b border-neutral-200 dark:border-stone-700 lg:border-b-0">
				<div class="poi-map-loader" data-poi-map-loader aria-hidden="true">
					<span class="poi-map-loader-dots">
						<span class="poi-map-loader-dot"></span>
						<span class="poi-map-loader-dot"></span>
						<span class="poi-map-loader-dot"></span>
					</span>
				</div>
				<div
					class="flex-auto w-full relative shadow-2xl z-40"
					data-mapbox-poi
					data-token-endpoint="/.netlify/functions/mapbox-token"
					data-pois-id="poi-data-{{ page.fileSlug }}"
					data-poi-list-id="poi-list-{{ page.fileSlug }}"
					data-poi-clusters="{{ poiClustersEnabled }}"
				></div>
			</div>

		<div class="activity-overlay poi-overlay relative flex-1 overflow-hidden lg:flex-1/2 lg:grow-0 lg:max-w-5xl! lg:order-2 lg:border-l border-neutral-200 dark:border-stone-700">
			<div class="scroll-container h-full overflow-y-auto p-container lg:pt-header">
				{% if image %}
				{% set imageSrc = image if image.startsWith("http") else "/media/" + image %}
				<figure class="activity-hero -mx-container -mt-container mb-4 lg:mb-6">
					<img src="{{ imageSrc }}" alt="{{ imageAlt or title }}" eleventy:widths="400,800,1200" sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" decoding="auto" fetchpriority="high" class="w-full object-cover max-h-[40vh]">
				</figure>
				{% endif %}
				<h1 class="u-text-2xl me-2">{{ title or page.fileSlug }}</h1>
				<div class="flow content mt-2 lg:mt-5 mb-5 lg:mb-8">{{ content | safe }}</div>
				<ul id="poi-list-{{ page.fileSlug }}" class="poi-list my-5 lg:mb-8">
					{% if groups.length %}
						{% for group in groups %}
							{% if not group.isPrimary %}
								<li class="poi-list-group-title u-text-lg">{{ group.title }}</li>
							{% endif %}
							{% for poi in group.items %}
								{{ poiRow(poi) }}
							{% endfor %}
						{% endfor %}
					{% else %}
						{% for poi in poiItems %}
							{{ poiRow(poi) }}
						{% endfor %}
					{% endif %}
				</ul>
				{% include 'components/likes.njk' %}
				<div class="pb-footer" aria-hidden="true"></div>
			</div>
		</div>
	</div>
{% elif mapKey %}
	<div class="container py-8">
		<h1 class="u-text-2xl me-2">{{ title or page.fileSlug }}</h1>
		<p class="u-text-sm opacity-70 mt-6">Er zijn nog geen POI's gevonden voor gebied `{{ kaart or map }}`.</p>
	</div>
{% else %}
	<div class="container py-8">
		<h1 class="u-text-2xl me-2">{{ title or page.fileSlug }}</h1>
		<p class="u-text-sm opacity-70 mt-6">Gebruik `type: poi` en geef in frontmatter `kaart:` op om een POI-kaart te tonen.</p>
	</div>
{% endif %}
