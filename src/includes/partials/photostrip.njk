{% set photo_strip = [
  {
    src: "https://images.unsplash.com/photo-1472214103451-9374bd1c798e?auto=format&fit=crop&w=400&q=80",
    alt: "Voorbeeldfoto van bergen en natuur",
    rotate: "rotate-2"
  },
  {
    src: "https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=400&q=80",
    alt: "Voorbeeldfoto van een mistig meer",
    rotate: "-rotate-2"
  },
  {
    src: "https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=400&q=80",
    alt: "Voorbeeldfoto van een landschap met heuvels",
    rotate: "rotate-2"
  },
  {
    src: "https://images.unsplash.com/photo-1439066615861-d1af74d74000?auto=format&fit=crop&w=400&q=80",
    alt: "Voorbeeldfoto van strand en zee",
    rotate: "-rotate-2"
  },
  {
    src: "https://images.unsplash.com/photo-1454496522488-7a8e488e8606?auto=format&fit=crop&w=400&q=80",
    alt: "Voorbeeldfoto van bergtoppen met sneeuw",
    rotate: "rotate-2"
  }
] %}

<div class="mt-2 mb-8 sm:mb-12">
  <div class="relative left-1/2 w-screen -translate-x-1/2 overflow-hidden">
    <div class="mx-auto w-full max-w-450 px-2 sm:px-4">
      <div class="flex justify-center gap-4 py-4 sm:gap-8">
        {% for photo in photo_strip %}
          <div class="relative w-36 sm:w-56 md:w-64 lg:w-72 flex-none overflow-hidden rounded-sm bg-neutral-100 dark:bg-neutral-800 {{ photo.rotate }}">
            <div class="aspect-4/5">
              <img src="{{ photo.src }}" alt="{{ photo.alt }}" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover">
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
