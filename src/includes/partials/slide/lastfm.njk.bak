<div class="swiper-slide swiper-slide--lastfm rounded w-unit-4 h-unit-4 overflow-hidden relative" data-daysago="4">
	<div class="bg-gradient-to-br from-neutral-300 to-neutral-400 dark:from-black dark:to-neutral-700 p-large rounded h-full w-full flex-col justify-stretch gap-small">

		<div class="flex-grow-0 flex mb-small gap-small items-center">
			<div class="flex-initial w-unit-1/2 h-unit-1/2 bg-[#d51007] rounded-sm ">
				<a href="https://www.last.fm/user/diederik_" target="_blank" rel="noopener noreferrer" class="text-white">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-full h-full scale-50">
						<path fill="currentcolor" d="m14.131 22.948-1.172-3.193s-1.912 2.131-4.771 2.131c-2.537 0-4.333-2.203-4.333-5.729 0-4.511 2.276-6.125 4.515-6.125 3.224 0 4.245 2.089 5.125 4.772l1.161 3.667c1.161 3.561 3.365 6.421 9.713 6.421 4.548 0 7.631-1.391 7.631-5.068 0-2.968-1.697-4.511-4.844-5.244l-2.344-.511c-1.624-.371-2.104-1.032-2.104-2.131 0-1.249.985-1.984 2.604-1.984 1.767 0 2.704.661 2.865 2.24l3.661-.444c-.297-3.301-2.584-4.656-6.323-4.656-3.308 0-6.532 1.251-6.532 5.245 0 2.5 1.204 4.077 4.245 4.807l2.484.589c1.865.443 2.484 1.224 2.484 2.287 0 1.359-1.323 1.921-3.828 1.921-3.703 0-5.244-1.943-6.124-4.625l-1.204-3.667C15.499 8.886 13.035 7.12 8.149 7.12c-5.287-.016-8.151 3.385-8.151 9.192 0 5.573 2.864 8.595 8.005 8.595 4.14 0 6.125-1.943 6.125-1.943z" />
					</svg>
				</a>
			</div>

			{# <div class="flex-auto">
				<h2 class="text-lg font-extrabold block tracking-tight whitespace-nowrap w-full ">Top Artiesten</h2>
			</div> #}
		</div>

		<div class="grid grid-cols-1 gap-1 md:gap-2">
			{%- set max_items = 5 -%}
				{% for artist in lastfm.overallArtists %}
					{%- if loop.index <= max_items -%}
					<div>
						<a href="https://last.fm/music/{{ artist.name | url | safe }}" target="_blank" rel="noopener noreferrer" class="group inline-flex  truncate gap-1 bg-white px-small py-1.5 md:py-2 rounded-full text-neutral-800 max-w-[90%]">
							<span class="text-base font-bold tracking-tight whitespace-nowrap truncate group-hover:opacity-80">{{ artist.name }}</span>
							{# <span class="text-base font-semibold tracking-tight whitespace-nowrap truncate opacity-50">{{ artist.playcount }} plays</span> #}
						</a>
						</div>
					{% endif %}
				{% endfor %}
		</div>
	</div>
</div>
