{%- set max_items = 4 -%}
{%- set count = 1 -%}

{% if concerts.data.results and concerts.data.results.length > 0 %}
<div class="swiper-slide swiper-slide--concerts rounded w-unit-4 h-unit-4 overflow-hidden relative" data-daysago="{{ concerts.data.results[0].properties.Datum.date.start | daysAgo }}">
	<div class="h-full w-full flex rounded bg-gradient-to-tl from-indigo-700 to-purple-900 flex-col justify-stretch gap-small text-base font-semibold tracking-tight p-large text-[#e9e5cd]">
		<div class="flex-grow-0">
			<div class="w-unit-1/2 h-unit-1/2 bg-indigo-400 rounded-sm text-white">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 -rotate-45 w-full h-full scale-[66%]">
					<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 0 1 0 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 0 1 0-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375Z" />
				</svg>
			</div>
		</div>
		<div class="flex flex-col gap-small">
			{% for concert in concerts.data.results %}
				{%- if loop.index <= max_items -%}
					{%- set artist = concert.properties.Artiest.title[0].text.content -%}
					{%- set datum = concert.properties.Datum.date.start -%}
					{%- set location = concert.properties.Locatie.select.name -%}

					<div class="group flex flex-col col-span-1 ">
						<span class="text-base font-bold tracking-tight whitespace-nowrap w-full truncate">{{ artist }}</span>
						<span class="text-base font-semibold tracking-tight whitespace-nowrap truncate opacity-75">{{ datum | readableDate }} &bull; <span class="opacity-50">{{ location }}</span></span>
					</div>

					{%- set count = count + 1 -%}
				{%- endif -%}
			{% endfor %}
		</div>

	</div>
</div>
{% endif %}


