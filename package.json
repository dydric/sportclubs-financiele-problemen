{
  "name": "diederikdijkstra.nl",
  "private": true,
  "version": "2025.01.03",
  "type": "module",
  "scripts": {
    "clean": "rm -rf _site",
    "clean-cache": "rm -rf _site .cache",
    "w:11ty": "eleventy --serve",
    "b:11ty": "eleventy",
    "w:tw": "tailwindcss -i src/css/tw/tw.css -o _site/css/tw.css --watch",
    "b:tw": "tailwindcss -i src/css/tw/tw.css -o _site/css/tw.css --minify",
    "w:js": "esbuild src/js/core.js 'src/js/feeds/*.js' --outbase=src/js --outdir=_site/js --bundle --watch",
    "b:js": "esbuild src/js/core.js 'src/js/feeds/*.js' --outbase=src/js --outdir=_site/js --bundle --minify",
    "watch": "cross-env NODE_ENV=development npm-run-all --parallel w:* ",
    "dev": "npx netlify dev",
    "build": "cross-env NODE_ENV=production npm-run-all clean b:*"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.0.0",
    "@11ty/eleventy-img": "^6.0.4",
    "netlify-cli": "^23.15.1",
    "netlify-plugin-cache": "^1.0.3"
  },
  "dependencies": {
    "@11ty/eleventy-fetch": "^5.1.1",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@netlify/blobs": "^8.2.0",
    "@tailwindcss/cli": "^4.1.18",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "esbuild": "^0.24.0",
    "html-minifier-terser": "^7.2.0",
    "npm-run-all": "^4.1.5",
    "rss-parser": "^3.13.0",
    "tailwindcss": "^4.1.18",
    "twemoji": "^14.0.2"
  }
}
