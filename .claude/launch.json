{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "PATH=/opt/homebrew/bin:$PATH npx netlify dev --port 8888"],
      "port": 8888,
      "autoPort": true
    },
    {
      "name": "static",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "PATH=/opt/homebrew/bin:$PATH npx serve _site -p 3000"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
